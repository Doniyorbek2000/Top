SADO_ENVIRONMENT=development
SADO_DATABASE_URL=postgresql+asyncpg://sado:sado@localhost:5432/sado
SADO_REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SADO_JWT_SECRET=change-me-in-production-please-32-bytes-min
SADO_PUBLIC_BASE_URL=http://localhost:8000
SADO_MEDIA_ROOT=./media

# SMS: "console" logs codes (dev); "eskiz" sends real SMS via notify.eskiz.uz
SADO_SMS_PROVIDER=console
SADO_ESKIZ_EMAIL=
SADO_ESKIZ_PASSWORD=
SADO_ESKIZ_SENDER=4546
# Accepted for any number outside production
SADO_DEV_OTP_CODE=12345

# Sado AI (translate / rewrite / summarize / @sado_ai bot). Leave empty to disable.
SADO_ANTHROPIC_API_KEY=
SADO_AI_MODEL=claude-opus-5-5

# WebRTC TURN server (coturn) for calls behind NAT, JSON list
SADO_TURN_URLS=[]
SADO_TURN_USERNAME=
SADO_TURN_CREDENTIAL=
